# Primary analysis model. Free-tier key works; the pipeline waits out rate limits.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.6-flash).
# gemini-3.5-flash-lite is the cheapest current-generation option.
# GEMINI_MODEL=

# Used as a fallback when the Gemini quota is exhausted, and for Reels
# transcription. Optional for YouTube-only runs.
OPENAI_API_KEY=

# Optional: override the fallback model (default: gpt-5-mini)
# OPENAI_MODEL=

# Required only for Instagram ingestion (runs apify/instagram-profile-scraper
# and apify/instagram-comment-scraper). https://console.apify.com/account/integrations
APIFY_TOKEN=
